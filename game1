<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roblozx - 3D Game</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background-color: #0a0a14; 
        overflow: hidden; 
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        user-select: none;
    }
    canvas { display: block; }

    /* SOL ÜST LOGO VE MENÜ */
    #logo-container {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 100;
    }
    #logo-btn {
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        color: #fff;
        border: 2px solid #7c3aed;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 18px;
        font-weight: 900;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
        transition: 0.3s;
    }
    #logo-btn:hover {
        box-shadow: 0 0 25px rgba(124, 58, 237, 0.8);
        transform: scale(1.05);
    }
    #logo-btn .icon {
        background: linear-gradient(90deg, #7c3aed, #ec4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 22px;
    }
    
    /* AÇILIR MENÜ */
    #leave-menu {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        background: #1a1a2e;
        border: 2px solid #7c3aed;
        border-radius: 10px;
        overflow: hidden;
        min-width: 200px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    }
    #leave-menu.active { display: block; }
    
    #leave-menu button {
        width: 100%;
        padding: 15px 20px;
        background: transparent;
        border: none;
        color: #ef4444;
        font-size: 16px;
        font-weight: bold;
        text-align: left;
        cursor: pointer;
        transition: 0.2s;
        border-bottom: 1px solid #2a2a4a;
    }
    #leave-menu button:hover { background: rgba(239, 68, 68, 0.2); }
    #leave-menu .info {
        padding: 15px 20px;
        color: #9090b0;
        font-size: 13px;
    }

    /* SKOR VE UI */
    #ui {
        position: absolute;
        top: 20px;
        right: 30px;
        color: #fff;
        font-size: 28px;
        font-weight: bold;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        pointer-events: none;
        z-index: 100;
    }
    #ui span { color: #ec4899; }

    /* KONTROLLER */
    #controls {
        position: absolute;
        bottom: 20px;
        width: 100%;
        text-align: center;
        color: #9090b0;
        font-size: 14px;
        pointer-events: none;
        z-index: 100;
    }

    /* OYUN BİTTİ EKRANI */
    #game-over {
        display: none;
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(10, 10, 20, 0.9);
        z-index: 200;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #fff;
    }
    #game-over.active { display: flex; }
    #game-over h1 { color: #ef4444; font-size: 60px; margin-bottom: 20px; text-shadow: 0 0 20px rgba(239, 68, 68, 0.8); }
    #game-over p { font-size: 24px; margin-bottom: 30px; }
    #game-over button {
        padding: 15px 40px;
        background: linear-gradient(90deg, #7c3aed, #ec4899);
        border: none;
        border-radius: 10px;
        color: #fff;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }
    #game-over button:hover { transform: scale(1.1); }
</style>
<!-- Three.js Kütüphanesi -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- SOL ÜST LOGO VE MENÜ -->
    <div id="logo-container">
        <div id="logo-btn">
            <span class="icon">🎮</span> ROBLOZX
        </div>
        <div id="leave-menu">
            <div class="info">Oyun Menüsü</div>
            <button onclick="leaveGame()">🚪 Ana Menüye Dön</button>
        </div>
    </div>

    <!-- SKOR -->
    <div id="ui">Skor: <span id="score">0</span></div>
    
    <!-- KONTROLLER -->
    <div id="controls">Hareket etmek için <b>W A S D</b> veya <b>Yön Tuşlarını</b> kullan.</div>

    <!-- OYUN BİTTİ EKRANI -->
    <div id="game-over">
        <h1>OYUN BİTTİ</h1>
        <p>Skorun: <span id="final-score">0</span></p>
        <button onclick="restartGame()">🔄 Tekrar Oyna</button>
    </div>

    <script>
        // ================= MENÜ MANTIĞI =================
        const logoBtn = document.getElementById('logo-btn');
        const leaveMenu = document.getElementById('leave-menu');

        logoBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            leaveMenu.classList.toggle('active');
        });

        // Ekrana tıklanınca menüyü kapat
        document.addEventListener('click', () => {
            leaveMenu.classList.remove('active');
        });

        // Ana menüye dönme fonksiyonu
        function leaveGame() {
            // Ana sayfadaki iframe'i kapatır (parent window ile iletişim)
            if (window.parent && window.parent.closeGame) {
                window.parent.closeGame();
            } else {
                alert("Ana menüye dönülüyor... (Sistem iframe içinde çalışmadığı için tam yönlendirilemedi)");
            }
        }

        // ================= 3D OYUN MOTORU =================
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0a0a14, 0.015); // Karanlık ve derinlik hissi

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 8, 15);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        document.body.appendChild(renderer.domElement);

        // Işıklar
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
        dirLight.position.set(10, 20, 10);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 1024;
        dirLight.shadow.mapSize.height = 1024;
        dirLight.shadow.camera.near = 0.5;
        dirLight.shadow.camera.far = 50;
        dirLight.shadow.camera.left = -15;
        dirLight.shadow.camera.right = 15;
        dirLight.shadow.camera.top = 15;
        dirLight.shadow.camera.bottom = -15;
        scene.add(dirLight);

        // Neon Işık (Pembe)
        const pointLight = new THREE.PointLight(0xec4899, 1, 30);
        pointLight.position.set(0, 5, 0);
        scene.add(pointLight);

        // Zemin (Grid Görünümü)
        const gridHelper = new THREE.GridHelper(40, 40, 0x7c3aed, 0x2a2a4a);
        gridHelper.position.y = -0.5;
        scene.add(gridHelper);

        // ================= OYUNCU =================
        const playerGeometry = new THREE.BoxGeometry(1.5, 1.5, 1.5);
        const playerMaterial = new THREE.MeshStandardMaterial({ 
            color: 0x7c3aed, 
            emissive: 0x7c3aed, 
            emissiveIntensity: 0.5,
            roughness: 0.2
        });
        const player = new THREE.Mesh(playerGeometry, playerMaterial);
        player.castShadow = true;
        player.position.y = 0.75;
        scene.add(player);

        // ================= OYUN DEĞİŞKENLERİ =================
        let score = 0;
        let isGameOver = false;
        let items = [];
        let keys = {};

        const scoreEl = document.getElementById('score');
        const gameOverScreen = document.getElementById('game-over');
        const finalScoreEl = document.getElementById('final-score');

        // Tuş Dinleyicileri
        window.addEventListener('keydown', e => {
            keys[e.key] = true;
            if(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) e.preventDefault();
        });
        window.addEventListener('keyup', e => keys[e.key] = false);

        // Obje Üretme
        function spawnItem() {
            if (isGameOver) return;

            const isBad = Math.random() < 0.25; // %25 kırmızı, %75 pembe
            const size = isBad ? 1.5 : 1.2;

            const itemGeo = new THREE.BoxGeometry(size, size, size);
            const itemMat = new THREE.MeshStandardMaterial({ 
                color: isBad ? 0xef4444 : 0xec4899,
                emissive: isBad ? 0xef4444 : 0xec4899,
                emissiveIntensity: 0.6
            });
            
            const item = new THREE.Mesh(itemGeo, itemMat);
            item.castShadow = true;
            
            // Rastgele X pozisyonu (Ekranın içinde kalacak şekilde)
            item.position.x = (Math.random() - 0.5) * 18; 
            item.position.y = 15;
            item.position.z = (Math.random() - 0.5) * 10; // Biraz derinlik katalım
            
            item.userData = {
                speed: 0.1 + Math.random() * 0.15 + (score * 0.002),
                isBad: isBad,
                rotationSpeed: (Math.random() - 0.5) * 0.1
            };

            scene.add(item);
            items.push(item);
        }

        // Çarpışma Kontrolü (Bounding Box)
        function checkCollision(obj1, obj2) {
            const box1 = new THREE.Box3().setFromObject(obj1);
            const box2 = new THREE.Box3().setFromObject(obj2);
            return box1.intersectsBox(box2);
        }

        // Animasyon ve Güncelleme Döngüsü
        function animate() {
            requestAnimationFrame(animate);

            if (!isGameOver) {
                // Oyuncu Hareketi
                const speed = 0.25;
                if (keys['ArrowLeft'] || keys['a'] || keys['A']) player.position.x -= speed;
                if (keys['ArrowRight'] || keys['d'] || keys['D']) player.position.x += speed;
                if (keys['ArrowUp'] || keys['w'] || keys['W']) player.position.z -= speed;
                if (keys['ArrowDown'] || keys['s'] || keys['S']) player.position.z += speed;

                // Oyuncu Sınırları
                player.position.x = Math.max(-9, Math.min(9, player.position.x));
                player.position.z = Math.max(-8, Math.min(8, player.position.z));

                // Objeleri Güncelle
                for (let i = items.length - 1; i >= 0; i--) {
                    let item = items[i];
                    item.position.y -= item.userData.speed;
                    item.rotation.x += item.userData.rotationSpeed;
                    item.rotation.y += item.userData.rotationSpeed;

                    // Ekrandan çıkanları sil
                    if (item.position.y < -2) {
                        scene.remove(item);
                        items.splice(i, 1);
                        continue;
                    }

                    // Çarpışma
                    if (checkCollision(player, item)) {
                        if (item.userData.isBad) {
                            endGame();
                        } else {
                            score += 10;
                            scoreEl.innerText = score;
                            scene.remove(item);
                            items.splice(i, 1);
                        }
                    }
                }

                // Işık animasyonu
                pointLight.position.x = Math.sin(Date.now() * 0.001) * 10;
            }

            renderer.render(scene, camera);
        }

        function endGame() {
            isGameOver = true;
            finalScoreEl.innerText = score;
            gameOverScreen.classList.add('active');
        }

        function restartGame() {
            isGameOver = false;
            score = 0;
            scoreEl.innerText = score;
            gameOverScreen.classList.remove('active');
            
            // Objeleri temizle
            items.forEach(item => scene.remove(item));
            items = [];

            // Oyuncuyu sıfırla
            player.position.set(0, 0.75, 0);
        }

        // Pencere Boyutu Değişince Kamerayı Ayarla
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Oyun Döngüsünü Başlat
        animate();
        
        // Her 800ms'de bir obje üret
        setInterval(spawnItem, 800);
    </script>
</body>
</html>
