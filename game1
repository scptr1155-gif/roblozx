<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roblozx - Game 1</title>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    body {
        background-color: #0a0a14;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        user-select: none;
    }
    canvas {
        background-color: #16213e;
        border: 3px solid #7c3aed;
        border-radius: 12px;
        box-shadow: 0 0 30px rgba(124, 58, 237, 0.4);
        max-width: 100%;
        max-height: 100%;
    }
    #ui {
        position: absolute;
        top: 20px;
        left: 30px;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        pointer-events: none;
    }
    #ui span {
        color: #ec4899;
    }
    #controls {
        position: absolute;
        bottom: 20px;
        color: #9090b0;
        font-size: 14px;
        text-align: center;
    }
</style>
</head>
<body>

    <div id="ui">Skor: <span id="score">0</span></div>
    <div id="controls">Hareket etmek için <b>Sol / Sağ Yön Tuşları</b> veya <b>A / D</b> kullan.</div>
    
    <canvas id="gameCanvas" width="800" height="600"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');

        // Oyuncu Ayarları
        let player = {
            x: canvas.width / 2 - 40,
            y: canvas.height - 60,
            width: 80,
            height: 20,
            speed: 8,
            color: '#7c3aed'
        };

        // Düşen Objeler
        let items = [];
        let score = 0;
        let gameOver = false;
        let keys = {};

        // Tuş Kontrolleri
        window.addEventListener('keydown', e => {
            keys[e.key] = true;
            // Sayfanın kaymasını engelle
            if(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', ' '].includes(e.key)) {
                e.preventDefault();
            }
        });
        window.addEventListener('keyup', e => keys[e.key] = false);

        // Rastgele Obje Oluşturma
        function spawnItem() {
            if (gameOver) return;
            
            // %20 ihtimalle kırmızı (kötü) obje, %80 ihtimalle pembe (iyi) obje
            const isBad = Math.random() < 0.2;
            
            items.push({
                x: Math.random() * (canvas.width - 30) + 15,
                y: -20,
                radius: isBad ? 15 : 12,
                speed: 3 + Math.random() * 4 + (score / 100), // Skor arttıkça hızlanır
                isBad: isBad,
                color: isBad ? '#ef4444' : '#ec4899'
            });
        }

        // Güncelleme Döngüsü
        function update() {
            if (gameOver) return;

            // Oyuncu Hareketi
            if (keys['ArrowLeft'] || keys['a'] || keys['A']) {
                player.x -= player.speed;
            }
            if (keys['ArrowRight'] || keys['d'] || keys['D']) {
                player.x += player.speed;
            }

            // Ekran Sınırları
            if (player.x < 0) player.x = 0;
            if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;

            // Objeleri Güncelle
            for (let i = items.length - 1; i >= 0; i--) {
                let item = items[i];
                item.y += item.speed;

                // Ekrandan çıkan objeleri sil
                if (item.y - item.radius > canvas.height) {
                    items.splice(i, 1);
                    continue;
                }

                // Çarpışma Kontrolü (Daire vs Dikdörtgen)
                let closestX = Math.max(player.x, Math.min(item.x, player.x + player.width));
                let closestY = Math.max(player.y, Math.min(item.y, player.y + player.height));
                
                let distanceX = item.x - closestX;
                let distanceY = item.y - closestY;
                let distanceSquared = (distanceX * distanceX) + (distanceY * distanceY);

                if (distanceSquared < (item.radius * item.radius)) {
                    // Çarpışma gerçekleşti
                    if (item.isBad) {
                        // Oyun Bitti
                        gameOver = true;
                    } else {
                        // Skor Artışı
                        score += 10;
                        scoreEl.innerText = score;
                    }
                    items.splice(i, 1);
                }
            }
        }

        // Çizim Döngüsü
        function draw() {
            // Arka planı temizle
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (gameOver) {
                // Oyun Bitti Ekranı
                ctx.fillStyle = 'rgba(10, 10, 20, 0.85)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.fillStyle = '#ef4444';
                ctx.font = 'bold 50px "Segoe UI"';
                ctx.textAlign = 'center';
                ctx.fillText('OYUN BİTTİ', canvas.width / 2, canvas.height / 2 - 20);
                
                ctx.fillStyle = '#fff';
                ctx.font = '24px "Segoe UI"';
                ctx.fillText('Skorun: ' + score, canvas.width / 2, canvas.height / 2 + 30);
                
                ctx.fillStyle = '#7c3aed';
                ctx.font = '18px "Segoe UI"';
                ctx.fillText('Yeniden başlamak için "R" tuşuna bas', canvas.width / 2, canvas.height / 2 + 80);
                return;
            }

            // Oyuncuyu Çiz
            ctx.fillStyle = player.color;
            ctx.beginPath();
            ctx.roundRect(player.x, player.y, player.width, player.height, 10);
            ctx.fill();
            
            // Oyuncuya parlama efekti ver
            ctx.shadowBlur = 15;
            ctx.shadowColor = player.color;
            ctx.fill();
            ctx.shadowBlur = 0; // Sıfırla

            // Objeleri Çiz
            items.forEach(item => {
                ctx.fillStyle = item.color;
                ctx.beginPath();
                ctx.arc(item.x, item.y, item.radius, 0, Math.PI * 2);
                ctx.fill();
                
                // Objelere parlama efekti
                ctx.shadowBlur = 10;
                ctx.shadowColor = item.color;
                ctx.fill();
                ctx.shadowBlur = 0;
            });
        }

        // Ana Oyun Döngüsü
        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        // Yeniden Başlatma
        window.addEventListener('keydown', e => {
            if (e.key === 'r' || e.key === 'R') {
                if (gameOver) {
                    score = 0;
                    scoreEl.innerText = score;
                    items = [];
                    player.x = canvas.width / 2 - 40;
                    gameOver = false;
                }
            }
        });

        // Obje üretme sıklığı
        setInterval(spawnItem, 700);

        // Oyunu başlat
        loop();
    </script>
</body>
</html>
