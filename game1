<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<title>Oyun 1</title>
<style>
  body { margin: 0; background: #0f0f1a; color: white; font-family: sans-serif; overflow: hidden; display: flex; justify-content: center; align-items: center; height: 100vh; }
  canvas { background: #16213e; border: 2px solid #7c3aed; border-radius: 12px; box-shadow: 0 0 20px rgba(124,58,237,0.5); }
  #ui { position: absolute; top: 20px; left: 20px; font-size: 24px; font-weight: bold; color: #ec4899; }
</style>
</head>
<body>
  <div id="ui">Skor: <span id="score">0</span></div>
  <canvas id="gameCanvas" width="800" height="600"></canvas>
  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('score');
    
    let player = { x: 400, y: 500, size: 30, speed: 7 };
    let items = [];
    let score = 0;
    let keys = {};

    window.addEventListener('keydown', e => keys[e.key] = true);
    window.addEventListener('keyup', e => keys[e.key] = false);

    function spawnItem() {
      items.push({
        x: Math.random() * (canvas.width - 20) + 10,
        y: -20,
        speed: 3 + Math.random() * 3,
        size: 20
      });
    }

    function update() {
      if (keys['ArrowLeft'] || keys['a']) player.x -= player.speed;
      if (keys['ArrowRight'] || keys['d']) player.x += player.speed;
      
      if (player.x < 0) player.x = 0;
      if (player.x > canvas.width - player.size) player.x = canvas.width - player.size;

      for (let i = items.length - 1; i >= 0; i--) {
        let item = items[i];
        item.y += item.speed;
        
        if (item.y > canvas.height) {
          items.splice(i, 1);
          continue;
        }
        
        if (item.y + item.size > player.y && 
            item.x + item.size > player.x && 
            item.x < player.x + player.size && 
            item.y < player.y + player.size) {
          score += 10;
          scoreEl.innerText = score;
          items.splice(i, 1);
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Oyuncu
      ctx.fillStyle = '#7c3aed';
      ctx.beginPath();
      ctx.roundRect(player.x, player.y, player.size, player.size, 8);
      ctx.fill();
      
      // Düşen objeler
      ctx.fillStyle = '#ec4899';
      items.forEach(item => {
        ctx.beginPath();
        ctx.arc(item.x + item.size/2, item.y + item.size/2, item.size/2, 0, Math.PI * 2);
        ctx.fill();
      });
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    setInterval(spawnItem, 800);
    loop();
  </script>
</body>
</html>
